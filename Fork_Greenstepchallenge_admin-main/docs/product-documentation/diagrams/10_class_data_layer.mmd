classDiagram
  class SupabaseClient {
    +URL: string
    +ANON_KEY: string
    +from(table)
    +rpc(name, args)
    +auth.signInWithOtp(email)
    +auth.verifyOtp(token)
  }

  class DataApiBarrel {
    <<index.js>>
    re-exports all entity modules
  }

  class Users {
    +getUsers()
    +getUserById(id)
    +createUser(data)
    +updateUser(id, data)
    +setUserActive(id, active)
  }

  class Challenges {
    +getChallenges()
    +getChallengeById(id)
    +createChallenge(data)
    +updateChallenge(id, data)
    +archiveChallenge(id)
  }

  class Templates {
    +getTemplates()
    +getTemplateById(id)
    +createTemplate(data)
    +updateTemplate(id, data)
    +deleteTemplate(id)
  }

  class Groups {
    +getGroups()
    +getGroupById(id)
    +createGroup(data)
    +updateGroup(id, data)
  }

  class Categories {
    +getCategories()
    +createCategory(data)
  }

  class Participation {
    +getParticipation()
    +logAction(userId, challengeId, actionId)
  }

  class ActivityLogs {
    +getActivityLogs()
    +logActivity(userId, action, details)
  }

  DataApiBarrel ..> Users
  DataApiBarrel ..> Challenges
  DataApiBarrel ..> Templates
  DataApiBarrel ..> Groups
  DataApiBarrel ..> Categories
  DataApiBarrel ..> Participation
  DataApiBarrel ..> ActivityLogs

  Users --> SupabaseClient
  Challenges --> SupabaseClient
  Templates --> SupabaseClient
  Groups --> SupabaseClient
  Categories --> SupabaseClient
  Participation --> SupabaseClient
  ActivityLogs --> SupabaseClient
