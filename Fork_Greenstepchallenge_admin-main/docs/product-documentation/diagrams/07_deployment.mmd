flowchart TB
  classDef client fill:#08427b,stroke:#052e56,color:#fff
  classDef edge fill:#1168bd,stroke:#0b4884,color:#fff
  classDef compute fill:#438dd5,stroke:#2e6295,color:#fff
  classDef datastore fill:#5d3a1f,stroke:#FFA726,color:#fff
  classDef ext fill:#999,stroke:#6b6b6b,color:#fff

  subgraph Browser["MPCA Staff Browser"]
    direction TB
    client["React SPA bundle<br/>(served from CDN)"]:::client
    storage[("localStorage<br/>dashboard layout")]:::datastore
  end

  subgraph Vercel["Vercel (Edge Network)"]
    direction TB
    static["Static SPA bundle<br/>(HTML/CSS/JS)"]:::edge
    funcs["Serverless Functions<br/>api/invite-user.js<br/>api/set-user-active.js"]:::compute
  end

  subgraph Supabase["Supabase Project"]
    direction TB
    auth["Auth (gotrue)<br/>OTP email sender"]:::compute
    rest["PostgREST API<br/>(RLS-enforced)"]:::compute
    pg[("Postgres 15<br/>14 migrations<br/>RLS policies + RPCs")]:::datastore
  end

  subgraph Email["Email Delivery"]
    smtp["Supabase SMTP<br/>(8-digit OTP codes)"]:::ext
  end

  client -->|"HTTPS<br/>static asset fetch"| static
  client -->|"HTTPS<br/>supabase-js<br/>(anon key + JWT)"| rest
  client -->|"HTTPS<br/>signInWithOtp<br/>verifyOtp"| auth
  client -->|"HTTPS<br/>privileged actions"| funcs
  funcs -->|"HTTPS<br/>service-role key"| rest

  auth -->|"Sends code"| smtp
  rest --> pg
  auth --> pg

  client <-.->|"R/W per-user"| storage
