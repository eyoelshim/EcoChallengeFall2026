# GreenStep Admin Console -- environment template
#
# Copy this file to `.env` (in the same directory) and fill in the values
# for your Supabase project. `.env` is gitignored.
#
# If you have access to the existing GreenStep Supabase project:
#   - URL  : Supabase dashboard -> Project Settings -> API -> Project URL
#   - key  : same page -> Project API Keys -> anon / public
#
# If you are provisioning a fresh Supabase project, see the
# "Provisioning a fresh Supabase project" section in README.md.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE
